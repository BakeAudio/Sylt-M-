
type Vec2:
    X: float = 0.0
    Y: float = 0.0

    fn Norma(self) -> float:
        return Sqrt(self.X * self.X + self.Y * self.Y)

    fn Sumar(self, Otro: &Vec2) -> Vec2:
        return Vec2(X: self.X + Otro.X, Y: self.Y + Otro.Y)

    fn Escalar(mut self, K: float):
        self.X = self.X * K
        self.Y = self.Y * K

fn Main():
    var A = Vec2(X: 3.0, Y: 4.0)
    let B = Vec2(X: 1.0, Y: 1.0)

    Print("A = {A}")
    Print("norma de A = {A.Norma()}")

    let C = A.Sumar(&B)
    Print("A + B = {C}")

    A.Escalar(2.0)
    Print("A escalado x2 = {A}")

    let D = A
    Print("D (que era A) = {D}")

