type Punto:
    X: float = 0.0
    Y: float = 0.0

    fn Norma(self) -> float:
        return Sqrt(self.X * self.X + self.Y * self.Y)

    fn Escalar(mut self, K: float):
        self.X = self.X * K
        self.Y = self.Y * K

enum Forma:
    Circulo(r: float)
    Recta(lado: float, alto: float)
    PuntoSuelto

fn Area(F: Forma) -> float:
    match F:
        case Circulo(R):
            return 3.14159 * R * R
        case Recta(L, A):
            return L * A
        case PuntoSuelto:
            return 0.0

fn Clasifica(N: int) -> string:
    match N:
        case 0:
            return "cero"
        case 1:
            return "uno"
        case _:
            return "muchos"

fn Fib(N: int) -> int:
    if N < 2:
        return N
    return Fib(N - 1) + Fib(N - 2)

fn Main():
    let A = Punto(X: 3.0, Y: 4.0)
    Print("A = {A}")
    Print("norma = {A.Norma()}")
    var B = Clone(A)
    B.Escalar(2.0)
    Print("B escalado = {B}")
    Print("A sigue igual = {A}")

    Print("fib(10) = {Fib(10)}")
    var Pares = 0
    for I in 0..10:
        if I % 2 == 0:
            Pares += 1
    Print("pares bajo 10: {Pares}")

    var Salto = 0
    while true:
        Salto += 3
        if Salto > 10:
            break
    Print("primer múltiplo de 3 mayor que 10: {Salto}")

    var Impares = 0
    for I in 0..20:
        if I % 2 == 0:
            continue
        Impares += 1
    Print("impares bajo 20: {Impares}")

    let S = "hola" + " " + "mundo"
    var T = "cuenta: "
    T += "{1 + 2}"
    Print(S)
    Print(T)
    let X = "abc"
    let Y = "abd"
    Print("cmp: {X < Y}")
    Print("eq: {X == X}")

    Print("min(3, 7) = {Min(3, 7)}, max = {Max(3, 7)}")
    Print("abs(-5) = {Abs(-5)}")
    Print("floor(2.7) = {Floor(2.7)}")
    Print("sqrt(2.0) = {Sqrt(2.0)}")
    Print("pow(2, 10) = {Pow(2.0, 10.0)}")
    Print("min float = {Min(2.5, 1.5)}")

    let F1 = Forma.Recta(3.0, 4.0)
    let F2 = Forma.Circulo(1.0)
    let F3 = Forma.PuntoSuelto
    Print("área recta: {Area(F1)}")
    Print("área círculo: {Area(F2)}")
    Print("área punto: {Area(F3)}")
    Print("F1 es {F1}")
    Print("F3 es {F3}")

    Print("clasifica: {Clasifica(0)} {Clasifica(1)} {Clasifica(5)}")

    let Copia = Clone(A)
    Print("copia de A = {Copia}")

    let EsVerdad = true
    Print("bool: {EsVerdad} y {not EsVerdad}")
    Print("y/o: {true and not false} {false or true}")
    Print("7/2 = {7 / 2}, 7%2 = {7 % 2}")
    Print("3*2+1 = {3.0 * 2 + 1}")
    Print("neg: {-4 + 10} {-2.5 + 1.0}")
