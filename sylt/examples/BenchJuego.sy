type Entidad:
    X: float = 0.0
    Y: float = 0.0
    VX: float = 0.0
    VY: float = 0.0

fn Main():
    let N = 2000
    let Frames = 120

    var Mundo: [Entidad] = []
    for I in 0..N:
        var E = Entidad(X: I * 0.5, Y: I * 0.25, VX: 1.0 + I * 0.001, VY: 0.5 + I * 0.0005)
        Mundo.Push(E)

    Print("entidades: {N}   frames: {Frames}")

    let T0 = TiempoMs()
    var Energia = 0.0
    for F in 0..Frames:
        for I in 0..N:
            Mundo[I].X += Mundo[I].VX
            Mundo[I].Y += Mundo[I].VY
            Energia += Mundo[I].VX * Mundo[I].VX + Mundo[I].VY * Mundo[I].VY
    let Total = TiempoMs() - T0

    let PorFrame = Max(Total / Frames, 0.001)
    let Fps = 1000.0 / PorFrame
    Print("tiempo total: {Total} ms")
    Print("por fotograma: {PorFrame} ms")
    Print("FPS estimados: {Fps}")
    Print("energía (verificación): {Energia}")
