enum EstadoPedido:
    Pendiente
    Pagado
    Enviado(tracking: string)
    Entregado(dias: int)
    Cancelado(motivo: string)

fn Describir(E: EstadoPedido) -> string:
    match E:
        case Pendiente:
            return "esperando pago"
        case Pagado:
            return "pagado, preparando envío"
        case Enviado(T):
            return "en camino con código {T}"
        case Entregado(D):
            return "entregado en {D} días"
        case Cancelado(M):
            return "cancelado: {M}"

fn DiasHastaEntrega(E: EstadoPedido) -> int:
    match E:
        case Entregado(D):
            return D
        case _:
            return 0

fn Main():
    let Pedido = EstadoPedido.Enviado("SY-2026-0042")
    Print("estado inicial: {Pedido}")
    Print(Describir(Pedido))
    let Hoy = EstadoPedido.Entregado(3)
    Print(Describir(Hoy))
    Print("tardó {DiasHastaEntrega(Hoy)} días")
    Print(Describir(EstadoPedido.Cancelado("stock agotado")))
    var Contador = 0
    for E in [EstadoPedido.Pendiente(), EstadoPedido.Pagado(), Pedido, Hoy]:
        Contador += 1
        Print("{Contador}. {Describir(E)}")
