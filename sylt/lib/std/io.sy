foreign:
    fn sy_io_leer_linea() -> string
    fn sy_io_leer_archivo(Ruta: string) -> string
    fn sy_io_escribir_archivo(Ruta: string, Contenido: string)
    fn sy_io_anexar_archivo(Ruta: string, Linea: string)
    fn sy_io_existe(Ruta: string) -> bool

fn LeerLinea() -> string:
    return sy_io_leer_linea()

fn LeerArchivo(Ruta: string) -> string:
    return sy_io_leer_archivo(Ruta)

fn EscribirArchivo(Ruta: string, Contenido: string):
    sy_io_escribir_archivo(Ruta, Contenido)

fn AnexarArchivo(Ruta: string, Linea: string):
    sy_io_anexar_archivo(Ruta, Linea)

fn Existe(Ruta: string) -> bool:
    return sy_io_existe(Ruta)
