import std.net
import std.str

fn ParteUrl(Url: string) -> (string, int, string):
    var SinEsquema = Url
    if std.str.EmpiezaCon(SinEsquema, "http://"):
        SinEsquema = std.str.Subcadena(SinEsquema, 7, std.str.Len(SinEsquema) - 7)
    if std.str.EmpiezaCon(SinEsquema, "https://"):
        SinEsquema = std.str.Subcadena(SinEsquema, 8, std.str.Len(SinEsquema) - 8)
    var Host = SinEsquema
    var Ruta = "/"
    var Puerto = 80
    let Barra = std.str.Buscar(SinEsquema, "/")
    if Barra >= 0:
        Host = std.str.Subcadena(SinEsquema, 0, Barra)
        Ruta = std.str.Subcadena(SinEsquema, Barra, std.str.Len(SinEsquema) - Barra)
    let DosPuntos = std.str.Buscar(Host, ":")
    if DosPuntos >= 0:
        Puerto = std.str.AEntero(std.str.Subcadena(Host, DosPuntos + 1, std.str.Len(Host) - DosPuntos - 1))
        Host = std.str.Subcadena(Host, 0, DosPuntos)
    return (Host, Puerto, Ruta)

fn Get(Url: string) -> (int, string):
    let (Host, Puerto, Ruta) = ParteUrl(Url)
    let Con = std.net.TcpIntentar(Host, Puerto)
    if Con < 0:
        return (-1, "no puedo conectar a " + Host)
    let Peticion = "GET " + Ruta + " HTTP/1.0\r\nHost: " + Host + "\r\nConnection: close\r\n\r\n"
    std.net.TcpEnviar(Con, Peticion)
    var Todo = ""
    while true:
        let Trozo = std.net.TcpRecibir(Con, 65536)
        if Trozo.Len() == 0:
            break
        Todo = Todo + Trozo
    std.net.TcpCerrar(Con)
    let FinLinea = std.str.Buscar(Todo, "\r\n")
    if FinLinea < 9:
        return (-1, Todo)
    let Codigo = std.str.AEntero(std.str.Subcadena(Todo, 9, 3))
    let Sep = std.str.Buscar(Todo, "\r\n\r\n")
    if Sep < 0:
        return (Codigo, "")
    let Cuerpo = std.str.Subcadena(Todo, Sep + 4, std.str.Len(Todo) - Sep - 4)
    return (Codigo, Cuerpo)
