foreign:
    fn sy_str_dividir(S: string, Sep: string) -> [string]
    fn sy_str_unir(Partes: [string], Sep: string) -> string
    fn sy_str_recortar(S: string) -> string
    fn sy_str_mayusculas(S: string) -> string
    fn sy_str_minusculas(S: string) -> string
    fn sy_str_reemplazar(S: string, De: string, A: string) -> string
    fn sy_str_empieza_con(S: string, Prefijo: string) -> bool
    fn sy_str_termina_con(S: string, Sufijo: string) -> bool
    fn sy_str_buscar(S: string, Sub: string) -> int
    fn sy_str_repetir(S: string, N: int) -> string
    fn sy_str_subcadena(S: string, Inicio: int, N: int) -> string
    fn sy_str_caracteres(S: string) -> [string]
    fn sy_str_a_entero(S: string) -> int

fn Dividir(S: string, Sep: string) -> [string]:
    return sy_str_dividir(S, Sep)

fn Unir(Partes: [string], Sep: string) -> string:
    return sy_str_unir(Partes, Sep)

fn Recortar(S: string) -> string:
    return sy_str_recortar(S)

fn Mayusculas(S: string) -> string:
    return sy_str_mayusculas(S)

fn Minusculas(S: string) -> string:
    return sy_str_minusculas(S)

fn Reemplazar(S: string, De: string, A: string) -> string:
    return sy_str_reemplazar(S, De, A)

fn EmpiezaCon(S: string, Prefijo: string) -> bool:
    return sy_str_empieza_con(S, Prefijo)

fn TerminaCon(S: string, Sufijo: string) -> bool:
    return sy_str_termina_con(S, Sufijo)

fn Buscar(S: string, Sub: string) -> int:
    return sy_str_buscar(S, Sub)

fn Repetir(S: string, N: int) -> string:
    return sy_str_repetir(S, N)

fn Subcadena(S: string, Inicio: int, N: int) -> string:
    return sy_str_subcadena(S, Inicio, N)

fn Caracteres(S: string) -> [string]:
    return sy_str_caracteres(S)

fn AEntero(S: string) -> int:
    return sy_str_a_entero(S)

fn Len(S: string) -> int:
    return S.Len()
